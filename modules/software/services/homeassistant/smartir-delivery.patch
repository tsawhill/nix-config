+def restore_on_send_failure(method):
+    """Do not publish an unsent requested state as successful."""
+    async def wrapped(self, *args, **kwargs):
+        names = ("_hvac_mode", "_target_temperature", "_last_on_operation",
+                 "_current_fan_mode", "_current_swing_mode")
+        before = {name: getattr(self, name) for name in names}
+        try:
+            return await method(self, *args, **kwargs)
+        except Exception:
+            for name, value in before.items():
+                setattr(self, name, value)
+            self.async_write_ha_state()
+            raise
+    return wrapped
+
 
