+static std::unordered_set<uint32_t> ignoredDbusCookies;
+
+static bool isDbusAppIgnored(const std::string& app) {
+    static const auto IGNOREAPPS = g_pConfigManager->getValue<Hyprlang::STRING>("general:ignore_dbus_inhibit_apps");
+    std::string_view  list       = *IGNOREAPPS;
+
+    while (!list.empty()) {
+        const auto comma = list.find(',');
+        auto       entry = list.substr(0, comma);
+        while (!entry.empty() && entry.front() == ' ')
+            entry.remove_prefix(1);
+        while (!entry.empty() && entry.back() == ' ')
+            entry.remove_suffix(1);
+        if (!entry.empty() && entry == app)
+            return true;
+        if (comma == std::string_view::npos)
+            break;
+        list.remove_prefix(comma + 1);
+    }
+
+    return false;
+}
